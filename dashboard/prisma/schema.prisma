datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id          String   @id @default("profile")
  userId      String?  @unique
  name        String
  tagline     String
  bio         String
  status      String   // "online" | "away" | "busy" | "offline"
  location    String
  skills      String[]
  socials     Json     // array of SocialHandle { platform, handle, url }
  avatar      String?
  banner      String?  // URL for profile banner (image or video)
  nameplate   String?  // URL for sidebar bottom banner/nameplate
  customTag   String?  // e.g. "#4269"
  borderStyle String?
  phoneNumber String?
  mbti        String?
  zodiac      String?
  updatedAt   DateTime @updatedAt
}

model ProfileHistory {
  id        String   @id @default(uuid())
  userId    String?
  assetType String   // "avatar" | "banner"
  url       String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Game {
  id            String   @id @default(uuid())
  userId        String?
  game          String
  handle        String?
  platform      String   // "PC" | "PSN" | "Xbox" | "Switch" | "Mobile" | "Multi"
  rank          String?
  mainCharacter String
  mainRole      String?
  category      String   // "Gacha RPG" | "Gacha Action" | "MOBA" | "FPS" | "Action RPG" | "Fighting"
  isActive      Boolean  @default(true)
  accentColor   String
  profileLink   String?
  icon          String?
  screenshot    String?
  createdAt     DateTime @default(now())

  resources     GameExternalResource[]
  showcaseItems GameShowcaseItem[]

  @@index([userId])
}

model GameShowcaseItem {
  id          String   @id @default(uuid())
  userId      String?
  gameId      String
  title       String
  description String?
  imageUrl    String
  category    String?  // e.g. "Pull / Gacha", "Build / Stats", "PvP / Ranked", "Achievement", "Collection"
  tags        Json?    // array of tag strings
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())

  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GameExternalResource {
  id          String   @id @default(uuid())
  userId      String?
  gameId      String
  name        String
  url         String
  icon        String?
  category    String?  // e.g. "Meta", "Tier List", "Heroes", "Builds", "Wiki", "Guides", "Official"
  description String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GameDossierCharacter {
  id          String   @id @default(uuid())
  userId      String?
  gameId      String
  name        String
  category    String   // e.g. "EXP Lane", "Destruction", "Duelist", "Main DPS"
  role        String?
  levelRank   String?  // e.g. "Mastery 7", "E6S1", "Level 90"
  winRate     Float?   @default(0)
  matches     Int?     @default(0)
  notes       String?
  avatarUrl   String?
  splashArt   String?
  accentColor String?
  isFavorite  Boolean  @default(false)
  pickRate    Float?
  banRate     Float?
  health      Int?
  damage      Int?
  difficulty  String?
  element     String?
  path        String?
  weapon      String?
  rarity      String?
  nation      String?
  birthday    String?
  faction     String?
  specialty   String?
  stats       Json?
  tags        Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([gameId])
  @@unique([gameId, name])
}

model GameCharacter {
  id           String   @id @default(uuid())
  userId       String?
  characterId  String?  // Reference to GameDossierCharacter
  gameId       String?  // Reference to Game
  gameName     String?  // Name of game (for missing game support)
  name         String
  title        String?  // e.g. "Herrscher of Finality"
  role         String?  // e.g. "Main DPS", "Jungler"
  category     String?  // e.g. "Destruction", "Gold Lane"
  element      String?  // e.g. "Fire", "Quantum", "Pyro"
  path         String?  // e.g. "Destruction", "Erudition"
  weapon       String?  // e.g. "Claymore", "Bow"
  rarity       String?  // e.g. "5-Star", "SSR"
  nation       String?  // e.g. "Liyue", "Belobog"
  birthday     String?  // e.g. "March 7"
  health       Int?
  damage       Int?
  difficulty   String?
  pickRate     Float?
  banRate      Float?
  winRate      Float?
  avatarUrl    String?
  cardImage    String?  // Independent 3:4 portrait card art for roster grid
  splashArt    String?  // Independent artwork from Character Collection
  accentColor  String?
  rank         Int?     @default(0)
  likes        Int      @default(0)
  isFavorite   Boolean  @default(true)
  notes        String?
  stats        Json?
  tags         Json?    // string[]
  links        Json?    // external links
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([gameId])
  @@index([characterId])
}

model Anime {
  id              String   @id @default(uuid())
  userId          String?
  title           String
  episodesWatched Int
  totalEpisodes   Int
  status          String   // "Watching" | "Completed" | "On Hold" | "Plan to Watch" | "Dropped"
  rating          Int?
  genre           String?
  studio          String?
  year            Int?
  posterUrl       String?
  synopsis        String?
  cast            String[]
  createdAt       DateTime @default(now())

  @@index([userId])
}

model FavoriteCharacter {
  id         String   @id @default(uuid())
  userId     String?
  name       String
  anime      String
  isFavorite Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Drama {
  id              String   @id @default(uuid())
  userId          String?
  title           String
  country         String   // "japanese" | "korean" | "chinese"
  episodes        Int
  episodesWatched Int
  status          String   // "Watching" | "Completed" | "Plan to Watch" | "On Hold"
  rating          Int
  genre           String
  year            Int
  platform        String?
  cast            String[]
  createdAt       DateTime @default(now())

  @@index([userId])
}

model HallOfFame {
  id                 String   @id @default(uuid())
  userId             String?
  name               String
  type               String   // "actor" | "actress" | "anime" | "singer" | "tokusatsu"
  status             String   // "GOAT Status" | "All-Star" | "Rising" | "Classic"
  knownFor           String[]
  nationality        String?
  singerType         String?  // "Solo Artist" | "Band / Group" | "Idol" | "VTuber" | "Vocalist"
  note               String?
  imageUrl           String?
  rank               Int?     @default(0)
  likes              Int      @default(0)
  isChampion         Boolean  @default(false)
  tokusatsuFranchise String?
  tokusatsuShow      String?
  associatedDramas   String[]
  createdAt          DateTime @default(now())

  @@index([userId])
}

model HallEvent {
  id            String   @id @default(uuid())
  userId        String?
  type          String   // e.g. "ADD_CHARACTER" | "DELETE_CHARACTER" | "UPDATE_CHARACTER" | "RANK_CHANGED" | "CHAMPION_CHANGED" | "VOTES_CHANGED" | "LIKES_CHANGED" | "WORK_ADDED" | "WORK_REMOVED" | "BADGE_UNLOCKED" | "RECORD_BROKEN" | "PRESTIGE_CHANGED" | "FAVORITE_CHANGED" | "CATEGORY_CHANGED" | "COUNTRY_CHANGED" | "NOTES_UPDATED"
  characterId   String?
  characterName String
  oldRank       Int?
  newRank       Int?
  oldVotes      Int?
  newVotes      Int?
  timestamp     DateTime @default(now())
  metadata      Json?

  @@index([userId])
  @@index([characterId])
}

model ChampionshipHistory {
  id                 String    @id @default(uuid())
  userId             String?
  characterId        String
  championName       String
  startDate          DateTime  @default(now())
  endDate            DateTime?
  durationDays       Int       @default(0)
  highestVotes       Int       @default(0)
  timesDefended      Int       @default(0)
  championshipNumber Int       @default(1)
  reasonEnded        String?   // e.g. "Surpassed in Votes", "Manual Champion Reassignment", "Active Champion"
  category           String?
  nationality        String?
  imageUrl           String?
  createdAt          DateTime  @default(now())

  @@index([userId])
  @@index([characterId])
}

model HallRankingSnapshot {
  id            String   @id @default(uuid())
  userId        String?
  characterId   String
  characterName String
  rank          Int
  votes         Int
  prestigeScore Float    @default(0)
  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([characterId])
}

model Note {
  id          String      @id @default(uuid())
  userId      String?
  title       String
  content     String
  hobbyId     String?
  isCuriosity Boolean     @default(false)
  hobby       HobbySkill? @relation(fields: [hobbyId], references: [id])
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model Link {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  url       String
  category  String   // e.g. "Watch", "Entertainment", "Book", "Productivity"
  createdAt DateTime @default(now())

  @@index([userId])
}

model GalleryItem {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  url       String
  caption   String?
  tags      Json?    // string[]
  category  String   @default("General")
  folder    String   @default("Root")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Song {
  id           String    @id @default(uuid())
  userId       String?
  title        String
  artist       String
  album        String?
  imageUrl     String?
  category     String    // e.g. "All-Time Favorites", "Chill Beats", "Hype/J-Pop", "K-Osts"
  duration     String?
  audioUrl     String?
  youtubeId    String?
  lyrics       String?
  geniusId     String?
  playlistId   String?
  playCount    Int       @default(0)
  isFavorite   Boolean   @default(false)
  lastPlayedAt DateTime?
  createdAt    DateTime  @default(now())
  memories     MusicMemory[]

  @@index([userId])
}

model MusicMemory {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  note      String
  createdAt DateTime @default(now())

  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, songId])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  description String?
  coverUrl    String?
  songs       Json?    // array of song IDs or track objects
  isAuto      Boolean  @default(false)
  autoType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([userId])
}

model MusicPlay {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  songTitle String
  artist    String
  duration  Int?     // seconds played
  completed Boolean  @default(false)
  playedAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, playedAt])
}

model MusicCollection {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  description String?
  emoji       String?
  coverUrl    String?
  songIds     Json?    // string[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([userId])
}

model MusicTimeline {
  id          String   @id @default(uuid())
  userId      String
  type        String   // SONG_ADDED | SONG_PLAYED | PLAYLIST_CREATED | LYRICS_CACHED | DOWNLOADED | DELETED
  entityId    String?
  entityTitle String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model MusicStreak {
  id             String   @id @default(uuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  bestStreak     Int      @default(0)
  lastListenDate String?  // YYYY-MM-DD
  totalDays      Int      @default(0)
  updatedAt      DateTime @updatedAt @default(now())
}

model MusicAchievement {
  id         String   @id @default(uuid())
  userId     String
  key        String   // FIRST_SONG | TEN_SONGS | FIFTY_SONGS | TEN_HOURS | OFFLINE_COLLECTOR | LYRICS_HUNTER | PLAYLIST_CREATOR
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model DramaLog {
  id              String   @id @default(uuid())
  userId          String?
  title           String
  type            String   // "Movie" | "Series"
  releaseYear     Int?
  plotSummary     String?
  posterUrl       String?
  mainActors      Json     // string[]
  statusBadge     String   @default("All-Star") // "GOAT Status" | "All-Star" | "Rising" | "Classic"
  omdbId          String?  // imdbID for deduplication
  country         String?  // "korean" | "japanese" | "hollywood" | "chinese" | "other"
  rating          String?  // e.g. "8.5"
  episodesWatched Int      @default(0)
  totalEpisodes   Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId])
}

model SavedPrompt {
  id         String   @id @default(uuid())
  userId     String?
  title      String
  targetAI   String
  promptText String
  createdAt  DateTime @default(now())

  @@index([userId])
}

model HobbySkill {
  id                 String         @id @default(uuid())
  userId             String?
  name               String         @unique
  category           String         // "Languages" | "Doctors" | "Martial Arts" | Custom
  priority           String         // "Priority" | "Haven't Started" | "Manifest"
  progress           Float          @default(0)
  level              Int            @default(1)
  xp                 Float          @default(0)
  streak             Int            @default(0)
  longestStreak      Int            @default(0)
  totalMinutes       Int            @default(0)
  longestSessionMin  Int            @default(0)
  lastLearnedAt      DateTime?
  lastStreakDate     String?
  highestXpSingleDay Float          @default(0)
  mostWordsWritten   Int            @default(0)
  reminderEnabled    Boolean        @default(false)
  reminderTime       String?        @default("20:00")
  reminderInterval   String?        @default("Every day")
  createdAt          DateTime       @default(now())
  logs               HobbyLog[]
  sessions           HobbySession[]
  notes              Note[]

  @@index([userId])
}

model HobbyLog {
  id        String     @id @default(uuid())
  userId    String?
  skillId   String
  skill     HobbySkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  delta     Float
  wordCount Int        @default(0)
  note      String?
  createdAt DateTime   @default(now())

  @@index([userId])
}

model HobbySession {
  id             String     @id @default(uuid())
  userId         String?
  skillId        String
  skill          HobbySkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  minutesLearned Int        @default(0)
  sessionXp      Float      @default(0)
  note           String?
  createdAt      DateTime   @default(now())

  @@index([userId])
  @@index([skillId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String?
  title       String
  message     String
  type        String   @default("info") // "reminder" | "milestone" | "streak" | "info"
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model ProjectItem {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  logo        String?
  heroBanner  String?
  description String
  category    String   // e.g. "Full-Stack Web", "Mobile App", "AI & ML", "Game Dev", "Utility", "Open Source"
  status      String   @default("Live") // "Live" | "Development" | "Beta" | "Maintenance" | "Archived" | "Experimental" | "Upcoming"
  version     String?  @default("v1.0.0")
  accentColor String   @default("#00F5FF")
  websiteUrl  String?
  githubUrl   String?
  docsUrl     String?
  figmaUrl    String?
  apiDocsUrl  String?
  adminUrl    String?
  stagingUrl  String?
  downloadUrl String?
  techStack   Json?    // array of string technologies
  tags        Json?    // array of string tags
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  isArchived  Boolean  @default(false)
  stats       Json?    // e.g. { stars: 120, users: "5.2k" }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model AiToolItem {
  id              String    @id @default(uuid())
  userId          String?
  name            String
  company         String?   // e.g. "OpenAI", "Anthropic", "Google", "Perplexity AI", "DeepSeek", "Anysphere"
  description     String
  logo            String?   // Emoji or image URL
  accentColor     String    @default("#10A37F")
  category        String    @default("💬 General AI")
  usageStatus     String?   @default("Daily") // "Daily" | "Weekly" | "Occasionally" | "Rarely" | "Experimental" | "Inactive" | "Archived"
  pricingModel    String?   @default("Freemium") // "Free" | "Freemium" | "Paid" | "Open Source"
  rating          Int?      @default(5) // 1 to 5 stars
  strengths       Json?     // array of string strengths (e.g. ["Coding", "Reasoning", "React Refactoring"])
  notes           String?   // multi-line personal evaluations & notes
  version         String?
  lastUsed        DateTime?
  launchCount     Int       @default(0)
  launchUrl       String?
  websiteUrl      String?
  docsUrl         String?
  apiUrl          String?
  pricingUrl      String?
  githubUrl       String?
  discordUrl      String?
  communityUrl    String?
  releaseNotesUrl String?
  blogUrl         String?
  roadmapUrl      String?
  youtubeUrl      String?
  tags            Json?     // array of string tags
  sortOrder       Int       @default(0)
  isFavorite      Boolean   @default(false)
  isPinned        Boolean   @default(false)
  isArchived      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model EmergencyContact {
  id               String    @id @default(uuid())
  userId           String?
  name             String
  nickname         String?
  relationship     String?
  company          String?
  category         String    @default("Other") // Family, Friends, Partner, Hospital, Police, Fire Department, Ambulance, Doctor, Clinic, Mental Health, Roadside Assistance, Insurance, Work, School, Security, Utilities, Other
  phoneNumber      String?
  whatsappNumber   String?
  telegramUsername String?
  email            String?
  website          String?
  address          String?
  avatar           String?
  notes            String?
  priority         String    @default("MEDIUM") // "HIGH" | "MEDIUM" | "LOW"
  favorite         Boolean   @default(false)
  available24Hours Boolean   @default(false)
  country          String?
  colorLabel       String?   // hex or color name
  lastContactedAt  DateTime?
  lastContactType  String?   // "CALL" | "WHATSAPP" | "EMAIL"
  birthday         String?   // e.g. "YYYY-MM-DD"
  reminders        Json?     // Array of reminder objects [{ type, date, note }]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([userId, category])
  @@index([userId, priority])
}
